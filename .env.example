# Hypitapp 环境变量示例（复制为 .env，切勿提交）
# 注意：所有密钥只放在本地 .env 或 GitHub Actions Secrets 中（§7.3 脱敏）

# --- 核心 ---
HYPITAPP_DATA_DIR=./data
HYPIT_RUNTIME=./hypit.runtime.json

# 账户库主密钥（32 字节 hex 或任意口令，内部 sha256 派生）。用于加密 API Key。
HYPITAPP_MASTER_KEY=change-me-to-a-long-random-secret

# 回调签名密钥（Actions 回调校验 X-Callback-Signature）
HYPITAPP_CALLBACK_SECRET=change-me-too

# 控制面鉴权令牌（Bearer）；留空则 /api/v1 不鉴权（仅本地开发）
HYPITAPP_API_TOKEN=

# --- 降档策略（§8.4）---
MAX_DURATION_SECONDS=180
MAX_SHOTS=10
NORMALIZE_SIZE=512
OUTPUT_RESOLUTION=720p

# --- 本地内核 ---
HYPIT_CLI=hypit

# --- 单次任务参数（`npx tsx src/index.ts task`）---
TASK_ID=demo1
TASK_REFERENCE_URL=
TASK_BRIEF=复刻参考视频

# --- Gemini 账户（2 个，§7.5）---
HYPIT_GEMINI_MAIN_KEY=
HYPIT_GEMINI_BACKUP_KEY=

# --- Agnes 账户（5 个，§7.5）---
HYPIT_AGNES_1_KEY=
HYPIT_AGNES_2_KEY=
HYPIT_AGNES_3_KEY=
HYPIT_AGNES_4_KEY=
HYPIT_AGNES_5_KEY=

# --- GitHub Actions 分发（§7.1 / §7.3：用 Fine-grained PAT，最小权限）---
GITHUB_PAT=
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_EVENT_TYPE=hypit-task
HYPITAPP_CALLBACK_URL=

# --- 服务 ---
PORT=8787
LOG_LEVEL=INFO
